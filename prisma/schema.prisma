generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FulfillmentType {
  SHIPPING
  PICKUP
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum CampaignType {
  SKORDEFESTEN
  CHRISTMAS
  EASTER
  CUSTOM
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AdminRole {
  ADMIN
  PRODUCER
}

model Producer {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  shortDescription    String
  longStory           String         @db.Text
  heroImageUrl        String
  galleryImages       String[]
  address             String
  latitude            Float
  longitude           Float
  website             String?
  email               String?
  phone               String?
  isActive            Boolean        @default(true)
  isSkordefestStation Boolean        @default(false)
  stationNumber       Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  products            Product[]
  pickupLocations     PickupLocation[]
  adminUsers          AdminUser[]

  @@index([isActive])
  @@index([isSkordefestStation])
}

model ProductCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  name                   String
  description            String    @db.Text
  story                  String?   @db.Text
  categoryId             String
  producerId             String
  priceOre               Int
  vatRate                Int       // 12 eller 25
  unit                   String
  stock                  Int       @default(0)
  images                 String[]
  isActive               Boolean   @default(true)
  isSeasonal             Boolean   @default(false)
  isSubscriptionEligible Boolean   @default(false)
  weightGrams            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  category               ProductCategory    @relation(fields: [categoryId], references: [id])
  producer               Producer           @relation(fields: [producerId], references: [id])
  orderItems             OrderItem[]
  campaignProducts       CampaignProduct[]
  preOrderItems          PreOrderItem[]

  @@index([isActive, categoryId])
  @@index([producerId])
  @@index([isSeasonal])
}

model PickupLocation {
  id            String    @id @default(cuid())
  producerId    String?
  name          String
  address       String
  latitude      Float
  longitude     Float
  openingHours  Json
  instructions  String    @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  producer      Producer? @relation(fields: [producerId], references: [id])
  orders        Order[]
  preOrders     PreOrder[]

  @@index([isActive])
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique
  customerEmail    String
  customerName     String
  customerPhone    String
  shippingAddress  Json?
  billingAddress   Json?
  fulfillmentType  FulfillmentType
  pickupLocationId String?
  subtotalOre      Int
  shippingCostOre  Int
  totalOre         Int
  vatTotalOre      Int
  status           OrderStatus     @default(PENDING)
  paymentIntentId  String?
  stripeSessionId  String?         @unique
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  pickupLocation   PickupLocation? @relation(fields: [pickupLocationId], references: [id])
  items            OrderItem[]

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceOre    Int
  productSnapshot Json

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model SubscriptionBox {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  description         String         @db.Text
  monthlyPriceOre     Int
  contentsDescription String         @db.Text
  imageUrl            String
  isActive            Boolean        @default(true)
  subscriptions       Subscription[]
}

model Subscription {
  id                    String              @id @default(cuid())
  customerEmail         String
  customerName          String
  boxId                 String
  stripeSubscriptionId  String              @unique
  status                SubscriptionStatus  @default(ACTIVE)
  nextDeliveryDate      DateTime?
  shippingAddress       Json
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  box                   SubscriptionBox     @relation(fields: [boxId], references: [id])

  @@index([status])
  @@index([customerEmail])
}

model Campaign {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  description  String         @db.Text
  type         CampaignType
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean        @default(false)
  heroImageUrl String
  createdAt    DateTime       @default(now())

  products     CampaignProduct[]
  preOrders    PreOrder[]
}

model CampaignProduct {
  id               String    @id @default(cuid())
  campaignId       String
  productId        String
  campaignPriceOre Int?
  maxQuantity      Int?
  sortOrder        Int       @default(0)

  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id])

  @@unique([campaignId, productId])
}

model PreOrder {
  id               String          @id @default(cuid())
  campaignId       String
  customerEmail    String
  customerName     String
  customerPhone    String
  pickupLocationId String
  subtotalOre      Int
  handlingFeeOre   Int             @default(3900)
  totalOre         Int
  status           OrderStatus     @default(PENDING)
  stripeSessionId  String?         @unique
  createdAt        DateTime        @default(now())

  campaign         Campaign        @relation(fields: [campaignId], references: [id])
  pickupLocation   PickupLocation  @relation(fields: [pickupLocationId], references: [id])
  items            PreOrderItem[]

  @@index([campaignId, status])
}

model PreOrderItem {
  id              String   @id @default(cuid())
  preOrderId      String
  productId       String
  quantity        Int
  unitPriceOre    Int
  productSnapshot Json

  preOrder        PreOrder @relation(fields: [preOrderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([preOrderId])
}

model DiscountCode {
  id               String       @id @default(cuid())
  code             String       @unique
  type             DiscountType
  value            Int          // procent (1-100) eller öre
  minOrderValueOre Int?
  maxUses          Int?
  usesCount        Int          @default(0)
  validFrom        DateTime
  validUntil       DateTime
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  @@index([code, isActive])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([unsubscribedAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  producerId   String?
  createdAt    DateTime  @default(now())

  producer     Producer? @relation(fields: [producerId], references: [id])

  @@index([role])
}
